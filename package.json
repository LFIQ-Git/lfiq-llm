{
  "name": "@lfiq/lfiq-llm",
  "version": "0.2.0",
  "description": "LFIQ router for Pursue, Watch, Parcel, Home and Website: Workers AI first, then the Anthropic API. Never OCP. Callers name a task key and a tier, never a model id.",
  "type": "module",
  "main": "./dist/llm.js",
  "types": "./dist/llm.d.ts",
  "exports": {
    ".": {
      "types": "./dist/llm.d.ts",
      "default": "./dist/llm.js"
    }
  },
  "files": ["dist", "llm.ts", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "check:dist": "npm run build && test -z \"$(git status --porcelain -- dist)\"",
    "test": "npm run build && node --test --test-timeout=30000 test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LFIQ-Git/lfiq-llm.git"
  },
  "license": "UNLICENSED"
}
